model Organization {
  id   String @id @default(uuid())
  name String
  slug String @unique

  users       User[]
  roles       Role[]
  departments Department[]
  employees   Employee[]
  projects    Project[]
  payrolls    Payroll[]
  payments    Payment[]
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}
