<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="color-scheme" content="light">
	<meta name="supported-color-schemes" content="light">
	<title>Welcome to EmNex</title>
</head>

<body style="margin: 0; padding: 0; background-color: #f0f4f8; font-family: Arial, Helvetica, sans-serif; color: #1f2937;">

	<div style="display: none; max-height: 0; overflow: hidden; opacity: 0;">
		Welcome to EmNex, <%= name %>. Your account has been created. Login with your temporary password.
	</div>

	<table
		width="100%"
		cellpadding="0"
		cellspacing="0"
		border="0"
		role="presentation"
		style="width: 100%; background-color: #f0f4f8; padding: 40px 16px;"
	>
		<tr>
			<td align="center">

				<table
					width="100%"
					cellpadding="0"
					cellspacing="0"
					border="0"
					role="presentation"
					style="width: 100%; max-width: 520px; background-color: #ffffff; border-radius: 16px; overflow: hidden;"
				>

					<!-- Header -->
					<tr>
						<td
							align="center"
							style="padding: 28px 32px; border-bottom: 1px solid #e5e7eb;"
						>
							<h1
								style="margin: 0; font-size: 22px; line-height: 1.3; color: #1e40af; font-weight: 700;"
							>
								EmNex
							</h1>
							<p
								style="margin: 6px 0 0; font-size: 13px; line-height: 1.5; color: #6b7280;"
							>
								Workforce, Project & Payroll Management
							</p>
						</td>
					</tr>

					<!-- Content -->
					<tr>
						<td style="padding: 40px 32px;">

							<h2
								style="margin: 0 0 14px; font-size: 25px; line-height: 1.3; color: #111827; font-weight: 700;"
							>
								Welcome, <%= name %>!
							</h2>

							<p
								style="margin: 0 0 24px; font-size: 15px; line-height: 1.7; color: #6b7280;"
							>
								Your account has been created in
								<strong style="color: #374151;"><%= organizationName %></strong>.
								Please use the credentials below to log in.
							</p>

							<!-- Credentials Box -->
							<table
								width="100%"
								cellpadding="0"
								cellspacing="0"
								border="0"
								role="presentation"
								style="width: 100%; margin-bottom: 26px; background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px;"
							>
								<tr>
									<td style="padding: 16px;">

										<p
											style="margin: 0 0 12px; font-size: 11px; line-height: 1.4; font-weight: 700; color: #3b82f6; text-transform: uppercase; letter-spacing: 1px;"
										>
											Your Login Credentials
										</p>

										<p style="margin: 0 0 8px; font-size: 14px; line-height: 1.5; color: #374151;">
											<strong>Email:</strong> <%= email %>
										</p>

										<p style="margin: 0 0 8px; font-size: 14px; line-height: 1.5; color: #374151;">
											<strong>Password:</strong>
											<span style="background-color: #fef3c7; padding: 2px 8px; border-radius: 4px; font-family: monospace; font-weight: 700; color: #92400e;">
												<%= temporaryPassword %>
											</span>
										</p>

										<p style="margin: 0; font-size: 14px; line-height: 1.5; color: #374151;">
											<strong>Role:</strong> <%= roleName %>
										</p>

									</td>
								</tr>
							</table>

							<!-- Important Notice -->
							<table
								width="100%"
								cellpadding="0"
								cellspacing="0"
								border="0"
								role="presentation"
								style="width: 100%; margin-bottom: 26px; background-color: #fef3c7; border: 1px solid #fcd34d; border-radius: 10px;"
							>
								<tr>
									<td style="padding: 16px;">
										<p style="margin: 0; font-size: 14px; line-height: 1.7; color: #92400e;">
											<strong>Important:</strong> You will be required to change your password on first login for security purposes.
										</p>
									</td>
								</tr>
							</table>

							<!-- Closing -->
							<p
								style="margin: 28px 0 0; font-size: 14px; line-height: 1.7; color: #6b7280;"
							>
								Thank you for joining EmNex.
								If you have any questions, please contact your administrator.
							</p>

						</td>
					</tr>

					<!-- Footer -->
					<tr>
						<td
							align="center"
							style="padding: 20px 32px; background-color: #f8fafc; border-top: 1px solid #e5e7eb;"
						>
							<p
								style="margin: 0; font-size: 12px; line-height: 1.5; color: #9ca3af;"
							>
								© EmNex System
							</p>
							<p
								style="margin: 6px 0 0; font-size: 11px; line-height: 1.5; color: #c0c6ce;"
							>
								This is an automated email. Please do not reply.
							</p>
						</td>
					</tr>

				</table>

			</td>
		</tr>
	</table>

</body>
</html>
