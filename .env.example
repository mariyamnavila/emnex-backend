NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emnex?schema=public"

# Allowed CORS origin (the frontend)
FRONTEND_URL=http://localhost:3000
# The FRONTEND URL too — Stripe sends payers back to ${APP_URL}/payment/success and /payment/cancel
APP_URL=http://localhost:3000

BCRYPT_SALT_ROUNDS=10

# JWT_ACCESS_SECRET must be identical in the frontend's .env.local
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

STRIPE_SECRET_KEY=sk_test_your_key
# Printed by `npm run stripe:webhook` locally; from the Stripe dashboard in production
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Optional — Google sign-in
GOOGLE_CLIENT_ID=

# Optional — avatar uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — welcome emails (Gmail address + app password)
SMTP_USER=
SMTP_PASSWORD=
